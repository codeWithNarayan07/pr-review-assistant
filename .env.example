# Copy to .env and fill in. Never commit .env.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Local (non-Docker) runs use these. docker-compose overrides them with container hostnames.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pr_assistant
REDIS_URL=redis://localhost:6379/0

# --- GitHub ---
# Any long random string; paste the SAME value into the GitHub webhook settings.
GITHUB_WEBHOOK_SECRET=change-me-to-a-long-random-string
GITHUB_API_URL=https://api.github.com
# Easiest: a personal access token with "Pull requests: write" (fine-grained) or "repo" (classic)
GITHUB_TOKEN=
# Or use a GitHub App instead of a token:
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# Optional: only review these repos (comma-separated owner/repo). Empty = all.
ALLOWED_REPOS=
SKIP_DRAFT_PRS=true

# --- LLM ---
# "none" = rule-based findings only (no API key needed). "anthropic" = AI summary too.
LLM_PROVIDER=none
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5

# --- optional ---
# Set to enable /admin/stats and /admin/jobs (send "Authorization: Bearer <token>")
ADMIN_TOKEN=
